# Stock Buddy 环境变量配置
LISTEN_ADDR=0.0.0.0:8080
DB_PATH=data/stock.db
RUST_LOG=info,stock_buddy=debug

# AI 研判 LLM 配置（支持任意 OpenAI 兼容 API）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot(Kimi): https://api.moonshot.cn/v1
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 同花顺金融数据 API（可选）
# 用途：涨停/跌停/炸板池与龙虎榜的优先数据源 —— 东财 push2 被风控时这几块
#       会整片空白，新浪又没有对应数据，这一路能补上；且它给的是真实连板天数、
#       封单额、涨停时间与涨停原因，比东财主源的占位值更准。
# 申请：https://fuyao.aicubes.cn/admin/  （鉴权头是 X-api-key，不是 Bearer）
# 注意：这是金融数据 API，不是大模型；AI 对话请用上面的 LLM_* 配置。
FUYAO_API_KEY=
